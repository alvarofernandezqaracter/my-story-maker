<mxfile host="app.diagrams.net" modified="2026-09-15T12:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="novelas-v2" name="Sistema de novelas históricas v2">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="canonbox" value="&lt;b&gt;Canon del proyecto&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 11px;&quot;&gt;— base de datos del libro. Única fuente de verdad: se lee antes de escribir, se actualiza solo al aprobar.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="780" height="150" as="geometry" />
        </mxCell>

        <mxCell id="loopbox" value="&lt;b&gt;Loop por capítulo&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 11px;&quot;&gt;— se repite una vez por cada capítulo de la escaleta&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=none;strokeColor=#9C9A92;fontColor=#3D3D3A;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="780" height="350" as="geometry" />
        </mxCell>

        <mxCell id="brief" value="&lt;b&gt;Brief del usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Época, premisa, tono, nº capítulos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="investigacion" value="&lt;b&gt;Agente investigador&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="arquitectura" value="&lt;b&gt;Agente arquitecto&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="outinv" value="&lt;b&gt;Output: dossier histórico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Fichas de datos de época (vestimenta, política, comida, lenguaje) · cada dato con su fuente · marcado como verificado o inventado&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="outarq" value="&lt;b&gt;Output: escaleta y personajes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Arco en 3 actos · una ficha por capítulo (qué pasa, quién sale) · ficha por personaje (voz, motivación, arco)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="130" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;Fichas de personajes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Voz, motivación, dónde está, qué sabe&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;Línea de tiempo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Sucesos de la trama cruzados con hechos reales&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="266" y="320" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;Dossier histórico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Datos de época + fuente, buscables&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="452" y="320" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;Resúmenes de capítulos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Un párrafo por capítulo ya aprobado&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D9E75;fontColor=#04342C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="638" y="320" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="genctx" value="&lt;b&gt;Generador de contexto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Selecciona del canon solo lo que hace falta para este capítulo&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="500" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="escritor" value="&lt;b&gt;Agente escritor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Output: el capítulo redactado&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="500" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rev1" value="&lt;b&gt;Continuidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Contradice el canon?&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="610" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rev2" value="&lt;b&gt;Anacronismos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Encaja con la época?&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="610" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rev3" value="&lt;b&gt;Lógica y ritmo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;¿Hay causa y efecto?&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="&lt;b&gt;Gate de calidad&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Umbral sobre las 3 notas · máx. 3 reintentos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="710" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="editor" value="&lt;b&gt;Editor global — pasada única al final&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;NO entra en el loop. Se ejecuta una sola vez, con todos los capítulos ya aprobados.&lt;br&gt;Lee los resúmenes del canon (no el texto entero) y devuelve una lista corta de retoques: arcos que no cierran, promesas sin cumplir, ritmo desequilibrado.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=12;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="850" width="400" height="110" as="geometry" />
        </mxCell>


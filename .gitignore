__pycache__/
*.py[cod]
.venv/
.env
config.real.json

# El canon de una novela no se versiona: lo escribe el orquestador y es salida,
# no fuente. Vive entero bajo novela-cc/, incluidos los borradores y retoques.
novela-cc/

# Las novelas ya terminadas, por lo mismo: son libros, no codigo. Este
# repositorio es el sistema que los escribe y no la estanteria donde se guardan.
novelas/

# Salida suelta en la raiz: no es fuente de nada. El informe de trazas se
# regenera con un comando, y ademas lleva dentro el gasto de una pasada
# concreta: lo que se versiona es lo que se aprende de el, en docs/spec/TRAZAS.md
/informe*.md

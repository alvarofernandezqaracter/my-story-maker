# Credenciales. Este fichero es la plantilla y SI se versiona; copialo a .env,
# que esta en .gitignore, y pon ahi los valores de verdad.
#
# Se lee al arrancar y no pisa lo que ya haya en el entorno: quien
# exporta una variable a mano lo hace para esa ejecucion.

# Trazas (§20). Se sacan de Langfuse en Settings > API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_PUBLICA
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_SECRETA
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Modo de ejecucion real (§12). El modo claude_code no la necesita: su
# credencial es la sesion de la propia CLI.
# ANTHROPIC_API_KEY=TU_CLAVE_AQUI

# Los jueces de §20. No la usa este repositorio: se registra una sola vez como
# conexion LLM del proyecto de Langfuse, y a partir de ahi quien llama al modelo
# es Langfuse. Aqui esta para no tenerla suelta en ningun otro sitio.
OPENROUTER_API_KEY=sk-or-v1-TU_CLAVE_AQUI
